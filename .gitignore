# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
**/backend.tf

# Crash & Logs
crash.log
crash.*.log
*.log

# Override
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment & Secrets
*.pem
*.key
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Backend (Java / Maven)
backend/target/
!backend/.mvn/wrapper/maven-wrapper.jar
backend/*.iml
backend/.idea/
backend/.vscode/

# Frontend (Node / React / Vite)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.vscode/
frontend/.idea/

# Global IDE
.idea/
.vscode/
*.iml
